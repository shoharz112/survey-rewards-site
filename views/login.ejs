<%- include('partials/header') %>

<form class="auth card" action="/auth/login" method="post">
  <h2>Welcome back</h2>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (notice) { %><div class="alert alert-info"><%= notice %></div><% } %>
  <input type="hidden" name="next" value="<%= next %>">
  <label for="email">Email</label>
  <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com">
  <label for="password">Password</label>
  <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
  <label style="display:flex; align-items:center; gap:.5rem; margin-top:.8rem; font-size:.9rem;">
    <input type="checkbox" name="remember" value="1" checked style="width:auto;">
    Remember me on this device
  </label>
  <button class="btn" type="submit" style="width:100%; margin-top:1rem;">Log in</button>

  <div class="divider">or</div>
  <% if (googleConfigured) { %>
    <a class="google-btn" href="/auth/google">
      <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.9-.1-1.5-.3-2.2H12v4.3h6.5c-.1 1.1-.8 2.7-2.4 3.8l-.1.1 3.5 2.7.2.1c2.2-2 3.8-5 3.8-8.8z"/><path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.8-2.9c-1 .7-2.4 1.2-4.1 1.2-3.1 0-5.8-2.1-6.8-5l-.1.1-3.7 2.9v.1C3.5 21.3 7.5 24 12 24z"/><path fill="#FBBC05" d="M5.2 14.4c-.2-.7-.4-1.5-.4-2.4s.1-1.7.4-2.4l-.1-.1-3.6-2.8-.1.1C.5 8.5 0 10.2 0 12s.5 3.5 1.4 5.2l3.8-2.8z"/><path fill="#EA4335" d="M12 4.7c1.8 0 3 .8 3.7 1.4l3.3-3.2C17.9 1.1 15.2 0 12 0 7.5 0 3.5 2.7 1.4 6.8l3.8 2.9c1-2.9 3.7-5 6.8-5z"/></svg>
      Continue with Google
    </a>
  <% } else { %>
    <div class="alert alert-info">Google sign-in is <strong>not configured yet</strong> — the site owner needs to add <code>GOOGLE_CLIENT_ID</code> / <code>GOOGLE_CLIENT_SECRET</code>. See README.md.</div>
  <% } %>
  <p style="margin-top:1rem; font-size:.9rem; color:var(--muted);">New here? <a href="/auth/signup">Create an account</a></p>
</form>

<%- include('partials/footer') %>
