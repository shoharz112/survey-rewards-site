<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= (typeof title !== 'undefined' ? title + ' — ' : '') + siteName %></title>
<style>
  :root { --bg:#0f172a; --card:#1e293b; --accent:#38bdf8; --accent2:#a78bfa; --text:#e2e8f0; --muted:#94a3b8; --good:#4ade80; --warn:#fbbf24; --bad:#f87171; }
  * { box-sizing: border-box; margin:0; padding:0; }
  body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background:var(--bg); color:var(--text); line-height:1.6; }
  a { color: var(--accent); }
  .wrap { max-width: 960px; margin: 0 auto; padding: 0 1rem; }
  nav { background:#0b1220; border-bottom:1px solid #243; padding:.75rem 0; }
  nav .wrap { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; }
  .brand { font-weight:800; font-size:1.25rem; color:#fff; text-decoration:none; }
  .brand span { color:var(--accent); }
  .navlinks a { color:var(--muted); text-decoration:none; margin-left:1rem; font-size:.95rem; }
  .navlinks a:hover { color:#fff; }
  .btn { display:inline-block; background:linear-gradient(135deg,var(--accent),var(--accent2)); color:#04121f; font-weight:700; padding:.7rem 1.4rem; border-radius:.6rem; text-decoration:none; border:0; cursor:pointer; font-size:1rem; }
  .btn:hover { filter:brightness(1.1); }
  .btn-ghost { background:transparent; color:var(--accent); border:1px solid var(--accent); }
  .card { background:var(--card); border:1px solid #334155; border-radius:.8rem; padding:1.25rem; margin:1rem 0; }
  .hero { text-align:center; padding:4rem 1rem 3rem; }
  .hero h1 { font-size:2.4rem; margin-bottom:.5rem; }
  .hero p { color:var(--muted); font-size:1.1rem; margin-bottom:1.5rem; }
  .steps { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; margin:2rem 0; }
  .step { background:var(--card); border:1px solid #334155; border-radius:.8rem; padding:1.25rem; }
  .step .n { font-size:1.6rem; font-weight:800; color:var(--accent); }
  form.auth { max-width:420px; margin:2rem auto; }
  label { display:block; margin:.8rem 0 .3rem; font-size:.9rem; color:var(--muted); }
  input, select, textarea { width:100%; padding:.7rem; border-radius:.5rem; border:1px solid #475569; background:#0b1220; color:var(--text); font-size:1rem; }
  .alert { padding:.8rem 1rem; border-radius:.5rem; margin:1rem 0; }
  .alert-error { background:#3b1113; border:1px solid var(--bad); color:#fecaca; }
  .alert-ok { background:#0f2e1d; border:1px solid var(--good); color:#bbf7d0; }
  .alert-info { background:#10233d; border:1px solid var(--accent); color:#bae6fd; }
  table { width:100%; border-collapse:collapse; font-size:.92rem; }
  th, td { text-align:left; padding:.55rem .4rem; border-bottom:1px solid #334155; }
  th { color:var(--muted); font-weight:600; }
  .pos { color:var(--good); } .neg { color:var(--bad); }
  .balance { font-size:2.2rem; font-weight:800; color:var(--accent); }
  .grid2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1rem; }
  iframe.wall { width:100%; height:80vh; border:0; border-radius:.8rem; background:#fff; }
  footer { margin-top:3rem; padding:1.5rem 0; border-top:1px solid #243; color:var(--muted); font-size:.85rem; text-align:center; }
  footer a { color:var(--muted); margin:0 .5rem; }
  .google-btn { display:flex; align-items:center; justify-content:center; gap:.6rem; width:100%; padding:.7rem; border-radius:.5rem; background:#fff; color:#1f2937; font-weight:600; text-decoration:none; border:0; cursor:pointer; font-size:1rem; margin-top:.8rem; }
  .divider { text-align:center; color:var(--muted); margin:1.2rem 0 .4rem; font-size:.85rem; }
  code { background:#0b1220; padding:.15rem .4rem; border-radius:.3rem; font-size:.9em; }
  pre { background:#0b1220; padding:1rem; border-radius:.5rem; overflow-x:auto; font-size:.85rem; }
  ol.steps-list li, ul.bullets li { margin:.4rem 0 .4rem 1.2rem; }
</style>
</head>
<body>
<nav>
  <div class="wrap">
    <a class="brand" href="/"><%- siteName.replace(/Rewards$/, '<span>Rewards</span>') %></a>
    <div class="navlinks">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/earn">Earn</a>
        <a href="/redeem">Redeem</a>
        <form action="/auth/logout" method="post" style="display:inline"><button class="btn btn-ghost" style="padding:.35rem .8rem; margin-left:1rem;" type="submit">Log out</button></form>
      <% } else { %>
        <a href="/auth/login">Log in</a>
        <a href="/auth/signup" class="btn" style="padding:.35rem .9rem;">Sign up</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="wrap">
