# =====================================================================
# Survey Rewards Site — environment configuration
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
# NEVER commit your real .env file.
# =====================================================================

# Port the app listens on (hosts like Render/Railway set this for you)
PORT=3000

# Public base URL of your deployed site, no trailing slash.
# Used for the Google OAuth callback URL and absolute links.
# Local dev: http://localhost:3000
BASE_URL=http://localhost:3000

# Secret used to sign session cookies. REQUIRED in production
# (the app refuses to boot in production without it).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. Default: ./data/app.db
DB_PATH=./data/app.db

# --- Google OAuth 2.0 (Sign in with Google) ---
# Create these in Google Cloud Console (see README for step-by-step).
# If left empty, the Google button shows a friendly "not configured" notice.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full callback URL registered in Google Cloud Console.
# Defaults to BASE_URL + /auth/google/callback if left empty.
GOOGLE_CALLBACK_URL=

# --- CPX Research offerwall ---
# Your CPX publisher App ID (from your CPX Research publisher dashboard).
# If left empty, the Earn page renders an in-app setup guide instead of the iframe.
CPX_APP_ID=
# Base offerwall URL from CPX (they give you this in the publisher dashboard).
CPX_OFFERWALL_URL=https://offerwall.cpx-research.com
# Secret key shared with CPX, used to verify postback signatures (secure_hash).
# Must match what CPX uses to sign postbacks. NEVER share or log this.
CPX_SECURE_KEY=

# --- Points economy ---
# How many site points equal 1 USD of survey rewards. Default 100.
# Used for display (e.g. estimated USD value on the Redeem page).
POINTS_PER_USD=100

# Optional: overrides the site name shown in the UI.
SITE_NAME=SurveyRewards
